# ==============================================
# 依存関係 (Dependencies)
# ==============================================

# パッケージインストール先（絶対にコミットしないでください）
node_modules/

# ==============================================
# ビルド成果物 (Build Output)
# ==============================================

# Vite等のビルド生成物（自動生成されるため不要）
dist/
dist-ssr/
build/

# Vite のキャッシュディレクトリ
.vite/

# ==============================================
# ロックファイル (Lock Files)
# ==============================================

# ※チーム開発では一貫性のために yarn.lock や package-lock.json の
# コミットが推奨されます。必要に応じて以下をコメントアウト・追加してください。
# yarn.lock
# package-lock.json
# pnpm-lock.yaml

# ==============================================
# ログファイル (Logs)
# ==============================================

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================
# エディタ・IDE設定 (Editor / IDE)
# ==============================================

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================================
# システムファイル (System Files)
# ==============================================

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ==============================================
# 環境変数ファイル (Environment Variables)
# ==============================================

# APIキー等の秘匿情報を含む可能性があるため絶対にコミットしないでください
# .env
# .env.local
# .env.development.local
# .env.test.local
# .env.production.local

# ==============================================
# テスト・カバレッジ (Testing)
# ==============================================

coverage/
.nyc_output/

# ==============================================
# TypeScript / その他 (Misc)
# ==============================================

# 型定義の自動生成ファイルなど（必要に応じて追加）
*.tsbuildinfo